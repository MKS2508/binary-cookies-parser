{
  "name": "@mks2508/binary-cookies-parser",
  "version": "2.0.1",
  "description": "Universal cookie parser supporting Netscape (cookies.txt), JSON, and macOS binary (.binarycookies) formats with auto-detection.",
  "author": "MKS2508",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cookies",
    "cookie-parser",
    "netscape",
    "cookies-txt",
    "binarycookies",
    "safari",
    "macos",
    "json-cookies",
    "parser",
    "typescript",
    "playwright",
    "puppeteer",
    "automation",
    "binary",
    "apple",
    "youtube",
    "yt-dlp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mks2508/binary-cookies-parser.git"
  },
  "bugs": {
    "url": "https://github.com/mks2508/binary-cookies-parser/issues"
  },
  "homepage": "https://github.com/mks2508/binary-cookies-parser#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --format esm --target node --minify && bun build ./src/index.ts --outdir ./dist/cjs --format cjs --target node --minify",
    "types": "tsc --project tsconfig.build.json",
    "prepublishOnly": "bun run build && bun run types",
    "test": "bun test",
    "example": "bun run examples/basic-usage.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@mks2508/binary-cookies-parser": "2.0.1"
  }
}
